{
  "name": "aipe",
  "version": "0.1.0",
  "description": "Spec workflow CLI for AI-assisted development. Generate filled specs from templates and project context.",
  "type": "module",
  "bin": {
    "aipe": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "spec",
    "cli",
    "claude-code",
    "codex",
    "prompt-engineering"
  ],
  "license": "MIT",
  "author": "rlynjb <rlynjb@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlynjb/aipe.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/rlynjb/aipe#readme",
  "bugs": {
    "url": "https://github.com/rlynjb/aipe/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
